{
  "name": "ilmways-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "IlmWays for Windows and macOS — keeps a school working when the internet drops",
  "author": "IlmWays <support@ilmways.com>",
  "homepage": "https://www.ilmways.com",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env ILMWAYS_SERVER_URL=http://localhost:3000 vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never"
  },
  "build": {
    "appId": "com.ilmways.desktop",
    "productName": "IlmWays",
    "copyright": "Copyright © 2026 IlmWays",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "IlmWays ${version}",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IlmWays",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Ihtisham225",
      "repo": "IlmWays-Desktop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.4.0",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
